        "jsCode": "const items = $input.all();\n\nconst vectors = items.map((item, i) => {\n  // Leemos la estructura exacta de 384 dimensiones que nos ha devuelto Cohere\n  const raw = item.json.embeddings[0];\n  \n  return {\n    id: 'doc-' + (i + 1),\n    values: raw, // Cohere ya entrega los vectores normalizados matemáticamente\n    metadata: { text: item.json.texts[0] } // Extraemos el texto directamente de la respuesta\n  };\n});\n\n// Empaquetamos todo en un único bloque para que Pinecone lo escriba de golpe\nreturn [{ json: { vectors } }];"
