        }
      }
    },
    {
      "parameters": {
        "description": "Busca información en la base de datos local sobre Asia. Pásale una 'query' (consulta) con palabras clave en inglés (ej. 'islands beaches southeast asia') para buscar en los documentos.",
        "jsCode": "// Accedemos a los textos cacheados en el flujo por el nodo anterior\nconst texts = $('Normalizar consulta').first().json.texts;\n\n// La consulta generada autónomamente por el agente\nconst searchQuery = typeof query !== 'undefined' ? query.toLowerCase() : '';\n\n// Extraemos palabras clave (más de 3 letras)\nconst keywords = searchQuery.split(/\\W+/).filter(k => k.length > 3);\n\nif (keywords.length === 0) return \"Por favor, proporciona palabras clave descriptivas.\";\n\n// Score simple: contamos coincidencias\nconst scoredDocs = texts.map(text => {\n  const t = text.toLowerCase();\n  let score = 0;\n  for (const kw of keywords) {\n    if (t.includes(kw)) score++;\n  }\n  return { text, score };\n});\n\n// Ordenamos de mayor a menor relevancia y tomamos el top 3\nscoredDocs.sort((a, b) => b.score - a.score);\nconst topDocs = scoredDocs.slice(0, 3).filter(d => d.score > 0).map(d => d.text);\n\nif (topDocs.length === 0) return \"No se encontró información sobre: \" + searchQuery;\n\n// Le devolvemos al agente los fragmentos encontrados\nreturn \"Contexto encontrado en la base de datos:\\n\\n\" + topDocs.join(\"\\n\\n---\\n\\n\");"
      },
      "type": "@n8n/n8n-nodes-langchain.toolCode",
      "typeVersion": 1.3,
      "position": [
        1024,
        464
      ],
      "id": "6026dfa8-439d-40b5-8a7d-9e7e26bd18bc",
      "name": "Herramienta buscador"
    },
    {
      "parameters": {
        "jsCode": "// Extraemos la pregunta\nconst question = $items()[0].json.question;\n\n// Consolidamos todos los textos extraídos en un array único\nconst texts = $items().map(i => i.json.text).filter(t => t);\n\n// Dejamos listo el contexto para que las herramientas puedan leerlo\nreturn [{\n  json: {\n    texts,\n    question\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
